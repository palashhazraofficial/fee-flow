<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/resources/favicon-512.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.26.25/sweetalert2.css" integrity="sha512-qP4rMpT6bFIS2bI6udQj2QQSlrtzqscQJJJQnuQrxbCp6goQRTN3Y4l5Y3gVzKNvlJyQFYd/qJCp6X9obaaB6Q==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="login.css">
    <title>FeeFlow | Login</title>
</head>
<body>
    <div class="page-container">

        <div class="header">FeeFlow</div>

        <div class="main-container">

            <div class="back-to-home"><a href="/" style="color: #DE350B;"><i class="fa-solid fa-arrow-left-long"></i></a></div>

            <form action="/login/verify-otp" method="POST" class="login-container">

                <div class="form-head">Log In</div>

                <div class="form-tag">Log in with your registered email id</div>

                <div class="inputbox-container">
                    <input type="email" class="inputbox" name="userEmail" placeholder="Enter your email id here" required>
                </div>

                <div class="otp-btn-container">
                    <input type="submit" value="Get OTP" class="otp-btn">
                </div>

            </form>

        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.26.25/sweetalert2.min.js"></script>
    <script>

        const errorMsg = "<%= error_msg %>"
        if (errorMsg && errorMsg.length > 0) {

            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: errorMsg,
                confirmButtonColor: "#ff0000"
            })
            
        }

        const loginForm = document.querySelector('.login-container');
        const submitBtn = document.querySelector('.otp-btn');
        let isSubmitting = false;

        loginForm.addEventListener('submit', function(event) {

            if (isSubmitting) {
                event.preventDefault();
                return;
            }
            isSubmitting = true;
            submitBtn.disabled = true;
            submitBtn.value = 'Sending OTP...';
            submitBtn.style.opacity = '0.7';
            submitBtn.style.cursor = 'not-allowed';

        })

        window.addEventListener('pageshow', function(event) {

            if (event.persisted) {
                isSubmitting = false;
                submitBtn.disabled = false;
                submitBtn.value = 'Get OTP';
                submitBtn.style.opacity = '1';
                submitBtn.style.cursor = 'pointer';
                Swal.close();
            }

        });

    </script>

</body> 
</html>